<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TurulMC.Launcher.Avalonia.Views.SettingsView">

    <ScrollViewer Margin="26,22,26,20">
        <StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Center">

            <StackPanel Spacing="4">
                <TextBlock Text="Beállítások" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TurulTextBrush}"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                           Foreground="{StaticResource TurulTextDimBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Profil -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Profil" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TurulTextBrush}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox Grid.Column="0" Watermark="Felhasználónév"
                                 Text="{Binding NewUsername, Mode=TwoWay}"
                                 Background="{StaticResource TurulSurface2Brush}"
                                 Foreground="{StaticResource TurulTextBrush}"
                                 CaretBrush="{StaticResource TurulGoldBrush}"
                                 BorderBrush="{StaticResource TurulBorderBrush}" CornerRadius="8"/>
                        <Button Grid.Column="1" Content="Létrehozás" Click="OnCreateProfile"
                                Background="{StaticResource TurulGoldBrush}"
                                Foreground="{StaticResource TurulBgBrush}"
                                BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="12"/>
                    </Grid>
                    <TextBlock Text="{Binding ProfileText}" FontSize="12"
                               Foreground="{StaticResource TurulTextDimBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Játék -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Játék" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TurulTextBrush}"/>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Alap RAM (MB)" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Minimum="1024" Maximum="65536" Increment="512"
                                       FormatString="0"
                                       Value="{Binding RamMb, Mode=TwoWay}"
                                       Background="{StaticResource TurulSurface2Brush}"
                                       Foreground="{StaticResource TurulTextBrush}"
                                       BorderBrush="{StaticResource TurulBorderBrush}"/>
                    </Grid>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Alap Minecraft verzió" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding MinecraftVersion, Mode=TwoWay}"
                                 Background="{StaticResource TurulSurface2Brush}"
                                 Foreground="{StaticResource TurulTextBrush}"
                                 CaretBrush="{StaticResource TurulGoldBrush}"
                                 BorderBrush="{StaticResource TurulBorderBrush}" CornerRadius="8"/>
                    </Grid>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Java útvonal" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Watermark="Üres = automatikus"
                                 Text="{Binding JavaPath, Mode=TwoWay}"
                                 Background="{StaticResource TurulSurface2Brush}"
                                 Foreground="{StaticResource TurulTextBrush}"
                                 CaretBrush="{StaticResource TurulGoldBrush}"
                                 BorderBrush="{StaticResource TurulBorderBrush}" CornerRadius="8"/>
                    </Grid>

                    <CheckBox Content="Hiányzó Java automatikus telepítése (Eclipse Temurin JRE)"
                              IsChecked="{Binding AutoInstallJava, Mode=TwoWay}"
                              Foreground="{StaticResource TurulTextDimBrush}"/>
                </StackPanel>
            </Border>

            <!-- Megjelenés -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Megjelenés" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TurulTextBrush}"/>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Téma" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="14" Height="14" CornerRadius="7"
                                                VerticalAlignment="Center"
                                                Background="{Binding Swatch}"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Egyedi akcentus" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding CustomAccentText, Mode=TwoWay}"
                                     Watermark="#D4AF37" MaxLength="7"/>
                            <Button Grid.Column="1" Content="Alkalmaz" Click="OnApplyAccent"
                                    Background="{StaticResource TurulSurface2Brush}"
                                    Foreground="{StaticResource TurulTextBrush}"
                                    BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" FontSize="12"/>
                            <Button Grid.Column="2" Content="Alaphelyzet" Click="OnResetAccent"
                                    Background="Transparent"
                                    Foreground="{StaticResource TurulTextDimBrush}"
                                    BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" FontSize="12"/>
                        </Grid>
                    </Grid>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Háttérkép" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Kiválasztás…" Click="OnPickBackground"
                                    Background="{StaticResource TurulSurface2Brush}"
                                    Foreground="{StaticResource TurulTextBrush}"
                                    BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" FontSize="12"/>
                            <Button Content="Törlés" Click="OnClearBackground"
                                    Background="Transparent"
                                    Foreground="{StaticResource TurulTextDimBrush}"
                                    BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" FontSize="12"/>
                            <TextBlock Text="{Binding BackgroundStatus}" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TurulTextFaintBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Átlátszóság" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding WindowOpacityPct, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding WindowOpacityText}" FontSize="12"
                                   VerticalAlignment="Center" MinWidth="44"
                                   Foreground="{StaticResource TurulTextDimBrush}"/>
                    </Grid>

                    <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Betűméret" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="85" Maximum="120" TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding UiScalePct, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding UiScaleText}" FontSize="12"
                                   VerticalAlignment="Center" MinWidth="44"
                                   Foreground="{StaticResource TurulTextDimBrush}"/>
                    </Grid>

                    <CheckBox Content="Felületi animációk (hover-átmenetek)"
                              IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}"
                              Foreground="{StaticResource TurulTextDimBrush}"/>
                    <TextBlock Text="A téma azonnal vált; a többi a Mentés gombbal rögzül. A betűméret 85–120% között skáláz."
                               FontSize="12" Foreground="{StaticResource TurulTextFaintBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Viselkedés -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Viselkedés" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TurulTextBrush}"/>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Játék indításakor" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding GameStartOptions}"
                                  SelectedItem="{Binding GameStartBehavior, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Bezáráskor" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CloseOptions}"
                                  SelectedItem="{Binding CloseBehavior, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Frissítési csatorna" FontSize="13"
                                   Foreground="{StaticResource TurulTextDimBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ChannelOptions}"
                                  SelectedItem="{Binding UpdateChannel, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Adatkönyvtár -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Adatkönyvtár" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TurulTextBrush}"/>
                    <TextBlock Text="{Binding DataRoot}" FontSize="12" TextWrapping="Wrap"
                               FontFamily="monospace"
                               Foreground="{StaticResource TurulTextDimBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Megnyitás" Click="OnOpenDataRoot"
                                Background="{StaticResource TurulSurface2Brush}"
                                Foreground="{StaticResource TurulTextBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" FontSize="12"/>
                        <Button Content="Mentés" Click="OnSave"
                                Background="{StaticResource TurulGoldBrush}"
                                Foreground="{StaticResource TurulBgBrush}"
                                BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SaveText}" FontSize="12"
                               Foreground="{StaticResource TurulOkBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
