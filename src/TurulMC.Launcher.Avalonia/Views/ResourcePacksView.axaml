<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TurulMC.Launcher.Avalonia.Views.ResourcePacksView">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="26,22,26,20">

        <!-- Fejléc -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Textúrák" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TurulTextBrush}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                       Foreground="{StaticResource TurulTextDimBrush}"/>
        </StackPanel>

        <!-- Instance választó + nézetváltó -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Instance:" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TurulTextDimBrush}"/>
                <ComboBox ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                          MinWidth="200" MaxWidth="320">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TurulTextFaintBrush}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Telepített" Click="OnShowInstalled"
                        IsVisible="{Binding IsBrowserMode}"
                        Background="Transparent"
                        Foreground="{StaticResource TurulTextBrush}"
                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                        Padding="12,7" CornerRadius="6" FontSize="12"/>
                <Button Content="🗺 Böngészés" Click="OnShowBrowser"
                        IsVisible="{Binding IsInstalledMode}"
                        Background="{StaticResource TurulSurface2Brush}"
                        Foreground="{StaticResource TurulTextBrush}"
                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                        Padding="12,7" CornerRadius="6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Tartalom -->
        <Border Grid.Row="2" Background="{StaticResource TurulSurfaceBrush}"
                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="6">
            <Panel>

            <!-- Telepített lista -->
            <DockPanel IsVisible="{Binding IsInstalledMode}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,6,8,4">
                    <Button Content="Hozzáadás…" Click="OnAdd"
                            Background="{StaticResource TurulSurface2Brush}"
                            Foreground="{StaticResource TurulTextBrush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                            Padding="12,7" CornerRadius="6" FontSize="12"/>
                    <Button Content="Törlés" Click="OnDelete"
                            Background="Transparent"
                            Foreground="{StaticResource TurulDangerBrush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                            Padding="12,7" CornerRadius="6" FontSize="12"/>
                    <Button Content="Frissítés" Click="OnRefresh"
                            Background="Transparent"
                            Foreground="{StaticResource TurulTextDimBrush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                            Padding="12,7" CornerRadius="6" FontSize="12"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Margin="20,28" MaxWidth="440">
                    <Border Width="54" Height="54" CornerRadius="27"
                            HorizontalAlignment="Center"
                            Background="{StaticResource TurulSurface2Brush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                        <TextBlock Text="🗺" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TurulGoldBrush}"/>
                    </Border>
                    <TextBlock Text="Nincs resource pack" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource TurulTextBrush}"/>
                    <TextBlock Text="A Hozzáadás gombbal .zip packokat másolhatsz be, vagy a Böngészéssel a Modrinth-ről tölthetsz le."
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TurulTextDimBrush}"/>
                </StackPanel>

                <ListBox x:Name="PackList" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Packs}"
                         SelectedItem="{Binding SelectedPack, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,7" ColumnSpacing="12">
                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          IsChecked="{Binding Active, Mode=OneWay}"
                                          Checked="OnPackChecked" Unchecked="OnPackUnchecked"/>
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource TurulSurface2Brush}"
                                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="🗺" FontSize="14" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TurulGoldDimBrush}"/>
                                        <Image Source="{Binding IconPath, Converter={StaticResource IconConverter}}"
                                               Width="40" Height="40" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TurulTextBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               IsVisible="{Binding HasDescription}"
                                               Foreground="{StaticResource TurulTextDimBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TurulTextFaintBrush}">
                                        <Run Text="formátum "/><Run Text="{Binding FormatText}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TurulGoldBrush}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SizeText}" FontSize="10"
                                               Foreground="{StaticResource TurulTextFaintBrush}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Modrinth böngésző -->
            <DockPanel IsVisible="{Binding IsBrowserMode}">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="8,6,8,4">
                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
                             Watermark="Keresés a Modrinth-en… (Enter is indít)"
                             KeyDown="OnSearchKey"/>
                    <Button Grid.Column="1" Content="Keresés" Click="OnSearch"
                            Background="{StaticResource TurulGoldBrush}"
                            Foreground="{StaticResource TurulBgBrush}"
                            BorderThickness="0" Padding="16,7" CornerRadius="6"
                            FontSize="12" FontWeight="SemiBold"
                            IsEnabled="{Binding CanSearch}"/>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{Binding SearchInfo}" FontSize="11"
                           Margin="12,0,12,6" TextWrapping="Wrap"
                           Foreground="{StaticResource TurulTextFaintBrush}"/>

                <ListBox Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding SearchResults}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,7" ColumnSpacing="12">
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="9"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource TurulSurface2Brush}"
                                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="▣" FontSize="18" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TurulGoldDimBrush}"/>
                                        <Image Source="{Binding IconPath, Converter={StaticResource IconConverter}}"
                                               Width="48" Height="48" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TurulTextBrush}">
                                        <Run Text="{Binding Title}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TurulTextFaintBrush}">
                                        <Run Text="{Binding Author}"/>
                                        <Run Text=" · "/><Run Text="{Binding DownloadsText}"/>
                                        <Run Text=" · "/><Run Text="{Binding InstalledText}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource TurulTextDimBrush}"
                                               TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding ActionText}"
                                        Click="OnInstallSearch"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanInstall}"
                                        MinWidth="110" Padding="12,8" CornerRadius="6"
                                        FontSize="12" FontWeight="SemiBold"
                                        Background="{StaticResource TurulGoldBrush}"
                                        Foreground="{StaticResource TurulBgBrush}"
                                        BorderThickness="0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Panel>
        </Border>

        <!-- Alsó sáv -->
        <StackPanel Grid.Row="3" Spacing="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TurulTextDimBrush}" TextWrapping="Wrap"/>
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                         Height="4" IsVisible="{Binding ProgressVisible}"
                         Foreground="{StaticResource TurulGoldBrush}"
                         Background="{StaticResource TurulBorderBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
