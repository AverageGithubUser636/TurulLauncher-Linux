<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TurulMC.Launcher.Avalonia.Views.SplashWindow"
        Title="TurulLauncher"
        Width="480" Height="420"
        MinWidth="480" MinHeight="420" MaxWidth="480" MaxHeight="420"
        Background="{StaticResource TurulBgBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        CanResize="False">

    <Border Background="{StaticResource TurulSurfaceBrush}"
            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
            CornerRadius="14" Margin="12" Padding="28,24">
        <StackPanel Spacing="14" VerticalAlignment="Center">

            <Image x:Name="LogoImage" Width="96" Height="96"
                   HorizontalAlignment="Center" Stretch="Uniform"/>

            <StackPanel Spacing="2">
                <TextBlock Text="TURULLAUNCHER" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TurulTextBrush}"/>
                <TextBlock x:Name="VersionBadge" Text="v4.6.0" FontSize="11"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TurulTextFaintBrush}"/>
            </StackPanel>

            <ProgressBar x:Name="StartupProgress" Minimum="0" Maximum="100" Value="0"
                         Height="6"
                         Foreground="{StaticResource TurulGoldBrush}"
                         Background="{StaticResource TurulBorderBrush}"/>
            <TextBlock x:Name="ProgressText" Text="Indítás…" FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TurulTextDimBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Border x:Name="Chip1" CornerRadius="10" Padding="10,4"
                        BorderThickness="1">
                    <TextBlock x:Name="Chip1Text" Text="Beállítások" FontSize="11"/>
                </Border>
                <Border x:Name="Chip2" CornerRadius="10" Padding="10,4"
                        BorderThickness="1">
                    <TextBlock x:Name="Chip2Text" Text="Instance-ok" FontSize="11"/>
                </Border>
                <Border x:Name="Chip3" CornerRadius="10" Padding="10,4"
                        BorderThickness="1">
                    <TextBlock x:Name="Chip3Text" Text="Felület" FontSize="11"/>
                </Border>
                <Border x:Name="Chip4" CornerRadius="10" Padding="10,4"
                        BorderThickness="1">
                    <TextBlock x:Name="Chip4Text" Text="Kész" FontSize="11"/>
                </Border>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
