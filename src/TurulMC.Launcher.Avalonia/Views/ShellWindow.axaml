<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TurulMC.Launcher.Avalonia.Views"
        x:Class="TurulMC.Launcher.Avalonia.Views.ShellWindow"
        Title="TurulLauncher"
        Width="1180" Height="740"
        MinWidth="940" MinHeight="600"
        Background="{StaticResource TurulBgBrush}"
        WindowStartupLocation="CenterScreen">

    <!--
        Mindhárom nézet állandó gyerek, és a kijelölés láthatósággal vált.
        Egyszerűbb és stabilabb, mint DataTemplate-tel VM-eket generálni:
        minden nézet a saját VM-ét használja, egyszer inicialálódik, és nem
        keletkezik kidobandó „árnyék" VM a navigációban.
    -->
    <!-- Háttérréteg: saját háttérkép + sötétítő (a tartalom alatta).
         A Window háttér színe megmarad, ha nincs kép. -->
    <Grid>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="False"/>
        <Border x:Name="BackgroundDim" Background="Black" Opacity="0.78"
                IsVisible="False"/>

        <!-- Betűméret-skála: layout-helyes nagyítás (LayoutTransform). -->
        <LayoutTransformControl x:Name="ContentScaler">
    <Grid ColumnDefinitions="234,*">

        <!-- Bal oldali navigáció -->
        <Border Grid.Column="0" Background="#0C0D10"
                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,22,16,10" Spacing="2"
                            HorizontalAlignment="Center">
                    <Image x:Name="LogoImage" Width="52" Height="52"
                           Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock Text="TURUL" FontSize="19" FontWeight="ExtraBold"
                               Foreground="{StaticResource TurulTextBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="LAUNCHER" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TurulGoldBrush}"
                               LetterSpacing="4"
                               HorizontalAlignment="Center" Margin="4,1,0,0"/>
                    <TextBlock Text="{Binding VersionText}" FontSize="10"
                               Foreground="{StaticResource TurulTextFaintBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,14" Spacing="8">
                    <!-- Profil-lábléc -->
                    <Border Background="{StaticResource TurulSurfaceBrush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{StaticResource TurulNavActiveBrush}"
                                    BorderBrush="{StaticResource TurulGoldBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding ProfileInitial}" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TurulGoldBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding ProfileName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TurulTextBrush}"/>
                                <TextBlock Text="offline profil" FontSize="10"
                                           Foreground="{StaticResource TurulTextFaintBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox x:Name="NavList" Classes="nav" Margin="12,8"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding NavItems}"
                         SelectedIndex="{Binding SelectedNavIndex}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Panel>
                                <!-- Szekciófejléc: nem választható. -->
                                <TextBlock Text="{Binding Label}" Classes="overline"
                                           Margin="12,12,4,5"
                                           IsVisible="{Binding IsHeader}"/>
                                <!-- Menüpont -->
                                <StackPanel Orientation="Horizontal" Spacing="13" Margin="6,5"
                                            IsVisible="{Binding IsItem}">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Width="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <!-- Jelvény: arany pötty (pl. elérhető frissítés). -->
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource TurulGoldBrush}"
                                            IsVisible="{Binding HasBadge}"/>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Jobb oldali tartalom -->
        <Panel Grid.Column="1">
            <views:HomeView x:Name="HomePage" />
            <views:ModsView x:Name="ModsPage" IsVisible="False" />
            <views:ResourcePacksView x:Name="PacksPage" IsVisible="False" />
            <views:ShadersView x:Name="ShadersPage" IsVisible="False" />
            <views:ModpacksView x:Name="ModpacksPage" IsVisible="False" />
            <views:ServersView x:Name="ServersPage" IsVisible="False" />
            <views:JavaView x:Name="JavaPage" IsVisible="False" />
            <views:SettingsView x:Name="SettingsPage" IsVisible="False" />
            <views:UpdateView x:Name="UpdatePage" IsVisible="False" />
            <views:DoctorView x:Name="DoctorPage" IsVisible="False" />
            <views:LogsView x:Name="LogsPage" IsVisible="False" />
            <views:RepairView x:Name="RepairPage" IsVisible="False" />
        </Panel>
    </Grid>

        </LayoutTransformControl>
    </Grid>
</Window>
