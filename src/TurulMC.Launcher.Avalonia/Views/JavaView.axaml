<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TurulMC.Launcher.Avalonia.Views.JavaView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="26,22,26,20">

        <!-- Fejléc -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Java" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TurulTextBrush}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                       Foreground="{StaticResource TurulTextDimBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*, 300" ColumnSpacing="14">

            <!-- Észlelt runtime-ok -->
            <Border Grid.Column="0" Background="{StaticResource TurulSurfaceBrush}"
                    BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,6,8,4">
                        <Button Content="Frissítés" Click="OnRefresh"
                                Background="{StaticResource TurulSurface2Brush}"
                                Foreground="{StaticResource TurulTextBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,8" CornerRadius="8" FontSize="12"/>
                        <Button Content="Telepített törlése" Click="OnRemove"
                                Background="Transparent"
                                Foreground="{StaticResource TurulDangerBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,8" CornerRadius="8" FontSize="12"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="8" Margin="20,28" MaxWidth="440">
                        <Border Width="54" Height="54" CornerRadius="27"
                                HorizontalAlignment="Center"
                                Background="{StaticResource TurulSurface2Brush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                            <TextBlock Text="☕" FontSize="22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TurulGoldBrush}"/>
                        </Border>
                        <TextBlock Text="Nincs felismert Java" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource TurulTextBrush}"/>
                        <TextBlock Text="Jobb oldalt telepíthetsz Eclipse Temurin JRE-t, vagy várj az automatikus felmérésre."
                                   FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource TurulTextDimBrush}"/>
                    </StackPanel>

                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Runtimes}"
                             SelectedItem="{Binding SelectedRuntime, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,7" ColumnSpacing="12">
                                    <Border Grid.Column="0" Width="48" Height="34" CornerRadius="7"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource TurulSurface2Brush}"
                                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding MajorText}" FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TurulGoldBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Version}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TurulTextBrush}"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11"
                                                   Foreground="{StaticResource TurulTextFaintBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SourceText}" FontSize="11"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource TurulTextDimBrush}"/>
                                </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Telepítés panel -->
            <StackPanel Grid.Column="1" Spacing="14">
                <Border Background="{StaticResource TurulSurfaceBrush}"
                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ajánlott" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TurulTextBrush}"/>
                        <TextBlock Text="{Binding RecommendedText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TurulTextDimBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource TurulSurfaceBrush}"
                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Új Java telepítése" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TurulTextBrush}"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Főverzió (Eclipse Temurin JRE)" FontSize="12"
                                       Foreground="{StaticResource TurulTextDimBrush}"/>
                            <ComboBox ItemsSource="{Binding MajorOptions}"
                                      SelectedItem="{Binding SelectedMajor, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <Button Content="Telepítés" Click="OnInstall"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="{StaticResource TurulGoldBrush}"
                                Foreground="{StaticResource TurulBgBrush}"
                                BorderThickness="0" Padding="12,9" CornerRadius="8"
                                FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"
                                IsEnabled="{Binding CanInstall}"/>
                        <TextBlock Text="A launcher a futó rendszerre való csomagot tölti (Linuxra .tar.gz-t)."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TurulTextFaintBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Alsó sáv -->
        <StackPanel Grid.Row="2" Spacing="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TurulTextDimBrush}" TextWrapping="Wrap"/>
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                         Height="4" IsVisible="{Binding ProgressVisible}"
                         Foreground="{StaticResource TurulGoldBrush}"
                         Background="{StaticResource TurulBorderBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
