<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TurulMC.Launcher.Avalonia.Views.DoctorView">

    <Grid RowDefinitions="Auto,Auto,*" Margin="26,22,26,20">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="Doctor" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TurulTextBrush}"/>
            <TextBlock Text="18 ellenőrzés egy helyen — ahol lehet, egy kattintásos javítással."
                       FontSize="12" Foreground="{StaticResource TurulTextDimBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14" ColumnSpacing="14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Futtatás" Click="OnRun"
                        Background="{StaticResource TurulGoldBrush}"
                        Foreground="{StaticResource TurulBgBrush}"
                        BorderThickness="0" CornerRadius="7" Padding="20,9" FontSize="13" FontWeight="SemiBold"/>
                <Button Content="Support" Click="OnBundle"
                        Background="{StaticResource TurulSurface2Brush}"
                        Foreground="{StaticResource TurulTextBrush}"
                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="14,9" FontSize="12"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TurulTextDimBrush}"
                       Text="{Binding SummaryText}" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{StaticResource TurulOkBrush}" CornerRadius="4" Padding="7,3">
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#08090B"
                               Text="{Binding OkText}"/>
                </Border>
                <Border Background="{StaticResource TurulDangerBrush}" CornerRadius="4" Padding="7,3">
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#08090B"
                               Text="{Binding FailText}"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource TurulSurfaceBrush}"
                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="4">
            <Panel>
                <!-- Üres állapot: a nagy panel ne egy fekete lyuk legyen. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" IsVisible="{Binding IsEmpty}">
                    <TextBlock Text="⚕" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource TurulGoldDimBrush}"/>
                    <TextBlock Text="Még nem futott le ellenőrzés" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TurulTextBrush}"/>
                    <TextBlock Text="A Futtatás gombbal ellenőrizheted a Javát, az Instance mappát,"
                               FontSize="12" TextAlignment="Center"
                               Foreground="{StaticResource TurulTextDimBrush}"/>
                    <TextBlock Text="az írási jogot, a hálózatot és a beállításfájlokat."
                               FontSize="12" TextAlignment="Center"
                               Foreground="{StaticResource TurulTextDimBrush}"/>
                </StackPanel>

                <ListBox Background="Transparent" BorderThickness="0"
                         IsVisible="{Binding IsNotEmpty}"
                         ItemsSource="{Binding Checks}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,8" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                    VerticalAlignment="Center"
                                    Background="{Binding BadgeBrush}">
                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold"
                                           Foreground="#08090B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TurulTextBrush}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                           Foreground="{StaticResource TurulTextDimBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TurulTextFaintBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
        </Border>

    </Grid>
</UserControl>
