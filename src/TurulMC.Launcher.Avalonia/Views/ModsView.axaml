<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TurulMC.Launcher.Avalonia.Views.ModsView">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="26,22,26,20">

        <!-- Fejléc -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Modok" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TurulTextBrush}"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                           Foreground="{StaticResource TurulTextDimBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="10" Padding="14,7"
                    VerticalAlignment="Center"
                    Background="{StaticResource TurulSurfaceBrush}"
                    BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TurulTextDimBrush}"/>
            </Border>
        </Grid>

        <!-- Instance választó + nézetváltó -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Instance:" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TurulTextDimBrush}"/>
                <ComboBox ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                          MinWidth="200" MaxWidth="320">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
                <Button Content="Telepített" Click="OnShowInstalled"
                        IsVisible="{Binding IsBrowserMode}"
                        Background="Transparent"
                        Foreground="{StaticResource TurulTextBrush}"
                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                        Padding="12,8" CornerRadius="8" FontSize="12"/>
                <Button Content="🧩 Böngészés" Click="OnShowBrowser"
                        IsVisible="{Binding IsInstalledMode}"
                        Background="{StaticResource TurulSurface2Brush}"
                        Foreground="{StaticResource TurulTextBrush}"
                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                        Padding="12,8" CornerRadius="8" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Tartalom -->
        <Border Grid.Row="2" Background="{StaticResource TurulSurfaceBrush}"
                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="8">
            <Panel>

            <!-- Telepített lista -->
            <DockPanel IsVisible="{Binding IsInstalledMode}">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="8,6,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Hozzáadás…" Click="OnAdd"
                                Background="{StaticResource TurulSurface2Brush}"
                                Foreground="{StaticResource TurulTextBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,7" CornerRadius="8" FontSize="12"/>
                        <Button Content="Törlés" Click="OnDelete"
                                Background="Transparent"
                                Foreground="{StaticResource TurulDangerBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,7" CornerRadius="8" FontSize="12"/>
                        <Button Content="Frissítés" Click="OnRefresh"
                                Background="Transparent"
                                Foreground="{StaticResource TurulTextDimBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,7" CornerRadius="8" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding FilterText, Mode=TwoWay}" Watermark="Keresés…"
                                 MinWidth="180" MaxWidth="260"/>
                        <ComboBox ItemsSource="{Binding FilterStates}"
                                  SelectedItem="{Binding FilterState, Mode=TwoWay}"
                                  MinWidth="130"/>
                        <Button Content="Mind be" Click="OnEnableAll"
                                Background="Transparent"
                                Foreground="{StaticResource TurulTextBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,7" CornerRadius="8" FontSize="12"/>
                        <Button Content="Mind ki" Click="OnDisableAll"
                                Background="Transparent"
                                Foreground="{StaticResource TurulTextBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,7" CornerRadius="8" FontSize="12"/>
                        <Button Content="Frissítések keresése" Click="OnCheckUpdates"
                                Background="Transparent"
                                Foreground="{StaticResource TurulGoldBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,7" CornerRadius="8" FontSize="12"/>
                        <Button Content="Kijelölt frissítése" Click="OnUpdateSelected"
                                Background="Transparent"
                                Foreground="{StaticResource TurulGoldBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,7" CornerRadius="8" FontSize="12"/>
                        <Button Content="Mind frissítése" Click="OnUpdateAll"
                                Background="Transparent"
                                Foreground="{StaticResource TurulGoldBrush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                Padding="12,7" CornerRadius="8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Margin="20,28" MaxWidth="440">
                    <Border Width="54" Height="54" CornerRadius="27"
                            HorizontalAlignment="Center"
                            Background="{StaticResource TurulSurface2Brush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                        <TextBlock Text="🧩" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TurulGoldBrush}"/>
                    </Border>
                    <TextBlock Text="Nincs mod ebben az Instance-ban" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource TurulTextBrush}"/>
                    <TextBlock Text="A Hozzáadás gombbal .jar fájlokat másolhatsz be, vagy a Böngészéssel a Modrinth-ről tölthetsz le (függőségekkel együtt)."
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TurulTextDimBrush}"/>
                </StackPanel>

                <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0"
                         SelectionMode="Multiple"
                         ItemsSource="{Binding Mods}"
                         SelectedItem="{Binding SelectedMod, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource TurulSurfaceBrush}"
                                    BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12" Margin="0,0,8,8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"
                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                              Checked="OnModChecked" Unchecked="OnModUnchecked"/>
                                    <Border Grid.Column="1" Width="46" Height="46" CornerRadius="10"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource TurulSurface2Brush}"
                                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="🧩" FontSize="16" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TurulGoldDimBrush}"/>
                                            <Image Source="{Binding IconPath, Converter={StaticResource IconConverter}}"
                                                   Width="46" Height="46" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource TurulTextBrush}"
                                                   TextWrapping="Wrap" MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TurulTextFaintBrush}">
                                            <Run Text="{Binding SizeText}"/>
                                            <Run Text=" · "/><Run Text="{Binding StateText}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding FileName}" FontSize="11"
                                                   Foreground="{StaticResource TurulTextFaintBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock Text="{Binding Error}" FontSize="11" IsVisible="{Binding HasError}"
                                                   Foreground="{StaticResource TurulDangerBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding UpdateText}" FontSize="11" FontWeight="SemiBold"
                                                   IsVisible="{Binding HasUpdate}"
                                                   Foreground="{StaticResource TurulGoldBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Top" Spacing="6"
                                                HorizontalAlignment="Right">
                                        <Border CornerRadius="9" Padding="10,4"
                                                Background="{Binding StateBg}"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding StateFg}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Modrinth böngésző -->
            <DockPanel IsVisible="{Binding IsBrowserMode}">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="8,6,8,4">
                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
                             Watermark="Keresés a Modrinth-en… (Enter is indít)"
                             KeyDown="OnSearchKey"/>
                    <Button Grid.Column="1" Content="Keresés" Click="OnSearch"
                            Background="{StaticResource TurulGoldBrush}"
                            Foreground="{StaticResource TurulBgBrush}"
                            BorderThickness="0" Padding="16,8" CornerRadius="8"
                            FontSize="12" FontWeight="SemiBold"
                            IsEnabled="{Binding CanSearch}"/>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{Binding SearchInfo}" FontSize="11"
                           Margin="12,0,12,6" TextWrapping="Wrap"
                           Foreground="{StaticResource TurulTextFaintBrush}"/>

                <ListBox Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding SearchResults}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource TurulSurfaceBrush}"
                                    BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12" Margin="0,0,8,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource TurulSurface2Brush}"
                                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="◈" FontSize="20" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TurulGoldDimBrush}"/>
                                            <Image Source="{Binding IconPath, Converter={StaticResource IconConverter}}"
                                                   Width="52" Height="52" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource TurulTextBrush}"
                                                   TextWrapping="Wrap" MaxLines="1"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Title}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TurulTextFaintBrush}">
                                            <Run Text="{Binding Author}"/>
                                            <Run Text=" · "/><Run Text="{Binding DownloadsText}"/>
                                            <Run Text=" · "/><Run Text="{Binding InstalledText}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TurulTextDimBrush}"
                                                   TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ActionText}"
                                            Click="OnInstallSearch"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding CanInstall}"
                                            MinWidth="104" Padding="12,9" CornerRadius="8"
                                            FontSize="12" FontWeight="SemiBold"
                                            Background="{StaticResource TurulGoldBrush}"
                                            Foreground="#0A0B0D"
                                            BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Panel>
        </Border>

        <!-- Alsó sáv -->
        <StackPanel Grid.Row="3" Spacing="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TurulTextDimBrush}" TextWrapping="Wrap"/>
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                         Height="4" IsVisible="{Binding ProgressVisible}"
                         Foreground="{StaticResource TurulGoldBrush}"
                         Background="{StaticResource TurulBorderBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
