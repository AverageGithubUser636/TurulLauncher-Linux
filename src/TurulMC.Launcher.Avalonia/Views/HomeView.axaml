<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TurulMC.Launcher.Avalonia.Views.HomeView">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,24,28,20">

        <!-- Cím -->
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
            <TextBlock Text="Játék" FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource TurulTextBrush}"/>
            <TextBlock Text="{Binding ProfileLine}" FontSize="12"
                       Foreground="{StaticResource TurulTextDimBrush}"/>
        </StackPanel>

        <!-- HERO: aktív Instance + JÁTÉK -->
        <Border Grid.Row="1" Margin="0,0,0,14"
                Background="{StaticResource TurulSurfaceBrush}"
                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="3" CornerRadius="3,3,0,0"
                        Background="{DynamicResource TurulGoldBrush}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="24,18,24,20">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="AKTÍV INSTANCE" Classes="overline"/>
                    <TextBlock Text="{Binding HeroName}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TurulTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="9" Padding="10,4"
                                Background="{StaticResource TurulSurface2Brush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding HeroVersion}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TurulTextBrush}"/>
                        </Border>
                        <Border CornerRadius="9" Padding="10,4"
                                Background="{StaticResource TurulSurface2Brush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding HeroLoader}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TurulTextBrush}"/>
                        </Border>
                        <Border CornerRadius="9" Padding="10,4"
                                Background="{StaticResource TurulSurface2Brush}"
                                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                                IsVisible="{Binding HasMods}">
                            <TextBlock Text="{Binding HeroMods}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TurulGoldBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding HeroLastPlayed}" FontSize="11"
                               Foreground="{StaticResource TurulTextFaintBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                    <Button x:Name="PlayButton" Content="▶  JÁTÉK" Click="OnPlay"
                            MinWidth="210" Padding="24,15"
                            FontSize="16" FontWeight="Bold"
                            HorizontalContentAlignment="Center"
                            Background="{StaticResource TurulGoldBrush}"
                            Foreground="{StaticResource TurulBgBrush}"
                            BorderThickness="0" CornerRadius="10"
                            IsEnabled="{Binding CanPlay}"/>
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                                 Height="4" IsVisible="{Binding ProgressVisible}"
                                 Foreground="{StaticResource TurulGoldBrush}"
                                 Background="{StaticResource TurulBorderBrush}"/>
                </StackPanel>
            </Grid>
            </DockPanel>
        </Border>

        <!-- Instance lista -->
        <Border Grid.Row="2" Background="{StaticResource TurulSurfaceBrush}"
                BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="10,8,10,6">
                    <TextBlock Text="INSTANCE-OK" Classes="overline" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <Button Content="Új Instance" Click="OnCreateInstance"
                            Background="{StaticResource TurulSurface2Brush}"
                            Foreground="{StaticResource TurulTextBrush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                            Padding="12,7" CornerRadius="8" FontSize="12"/>
                    <Button Content="Szerkesztés" Click="OnEditInstance"
                            Background="Transparent"
                            Foreground="{StaticResource TurulTextBrush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                            Padding="12,7" CornerRadius="8" FontSize="12"/>
                    <Button Content="Törlés" Click="OnDeleteInstance"
                            Background="Transparent"
                            Foreground="{StaticResource TurulDangerBrush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1"
                            Padding="12,7" CornerRadius="8" FontSize="12"/>
                </StackPanel>

                <!-- Üres állapot -->
                <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Margin="20,24" MaxWidth="420">
                    <Border Width="54" Height="54" CornerRadius="27"
                            HorizontalAlignment="Center"
                            Background="{StaticResource TurulSurface2Brush}"
                            BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                        <TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Még nincs Instance" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource TurulTextBrush}"/>
                    <TextBlock Text="{Binding EmptyText}" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TurulTextDimBrush}"/>
                </StackPanel>

                <ListBox x:Name="InstanceList"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Instances}"
                         SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,9" ColumnSpacing="14">
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="{StaticResource TurulSurface2Brush}"
                                        BorderBrush="{StaticResource TurulBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TurulTextBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TurulTextFaintBrush}">
                                        <Run Text="MC "/><Run Text="{Binding MinecraftVersion}"/>
                                        <Run Text=" · "/><Run Text="{Binding Loader}"/>
                                        <Run Text=" · "/><Run Text="{Binding RamMb}"/><Run Text=" MB"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding ModpackName}" FontSize="11"
                                               Foreground="{StaticResource TurulGoldBrush}"/>
                                    <TextBlock Text="{Binding LastPlayedText}" FontSize="10"
                                               Foreground="{StaticResource TurulTextFaintBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Állapot -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="12" Margin="4,12,0,0"
                   Foreground="{StaticResource TurulTextDimBrush}" TextWrapping="Wrap"/>

    </Grid>
</UserControl>
