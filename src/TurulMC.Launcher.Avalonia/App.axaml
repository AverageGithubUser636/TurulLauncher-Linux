<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TurulMC.Launcher.Avalonia.Views"
             x:Class="TurulMC.Launcher.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <!-- ============================================================
             TurulLauncher márkastílus.
             A Fluent alapértelmezett akcentusa kék; itt felülírjuk aranyra,
             hogy a felület egységes legyen a Windows-os verzió HTML UI-jával.
             ============================================================ -->

        <!-- Kártya: puhább, árnyékolt, lélegző. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource TurulSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TurulBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="BoxShadow" Value="0 10 28 0 #30000000" />
        </Style>

        <!-- Gombok: az átmeneteket a ThemeService kapcsolja (animáció-állítás).
             Itt nincsenek, hogy a „kikapcsolva" valóban azonnali legyen. -->
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Inter" />
        </Style>

        <Style Selector="Button.ghost /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TurulSurface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TurulTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TurulBorderBrush}" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Szöveges mezők: magasabb, fókuszban arany keret. -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource TurulGoldBrush}" />
        </Style>

        <!-- ComboBox: a legördülő elemei is arany kijelölést kapnak. -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TurulSelectBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TurulGoldBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TurulGoldBrush}" />
        </Style>

        <!-- Lista: egységes sötét háttér, ne villanjon fehérre. -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!--
            Kijelölés / húzás ARANYRA — MINDEN listára (nem csak a navigációra).
            A Fluent alapértelmezett kijelölése kék, ami teljesen kilógott a
            márkából: ez látszott az instance lista kék során is.
        -->
        <Style Selector="ListBox > ListBoxItem">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TurulTextBrush}" />
        </Style>

        <Style Selector="ListBox > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TurulSurface2Brush}" />
        </Style>

        <Style Selector="ListBox > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TurulNavActiveBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox > ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TurulGoldBrush}" />
        </Style>

        <!-- A navigáció ritmusa + arany-tintás aktív pill (Windows-minta). -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.nav > ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TurulTextDimBrush}" />
        </Style>

        <Style Selector="ListBox.nav > ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TurulGoldBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Checkbox: arany jelölő, sötét pipa.
             A Fluent 11.3 sablonrészei: PART_Border (a teljes sor kerete —
             NEM a kis doboz, ezért azt nem színezzük), NormalRectangle (a kis
             színes doboz) és CheckGlyph (a pipa). A régi OuterBorder név nem
             létezik, ezért maradt kék a jelölő. -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TurulTextDimBrush}" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource TurulGoldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TurulGoldBrush}" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="#08090B" />
        </Style>

        <!-- Csúszka: a Fluent a Foreground-ra köti a kitöltést és a pöcköt,
             ezért elég azt aranyra állítani (a sablon helyi értékei
             a Border/Thumb Background-beállítást felülírnák). -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource TurulGoldBrush}" />
        </Style>

        <Style Selector="Slider /template/ Border#TrackBackground">
            <Setter Property="Background" Value="{DynamicResource TurulBorderBrush}" />
        </Style>

        <Style Selector="Slider /template/ Thumb#thumb /template/ Border">
            <Setter Property="Background" Value="{DynamicResource TurulGoldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TurulGoldBrush}" />
        </Style>

        <!-- Fókuszgyűrű arany. -->
        <Style Selector=":focus /template/ Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource TurulGoldBrush}" />
        </Style>

        <!-- Felirat (overline): kis kapitális szekciócím. -->
        <Style Selector="TextBlock.overline">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TurulTextFaintBrush}" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>

        <!-- Vékony, sötét görgetősáv. -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- TurulLauncher márka-paletta (a Windows-verzió sötét-arany UI-ja alapján).
             Háttér közel fekete, kártyák lépcsőzetesen világosabbak,
             akcentus meleg arany, játék-gomb élénkzöld. -->
        <Color x:Key="TurulBg">#0A0B0D</Color>
        <Color x:Key="TurulSurface">#101215</Color>
        <Color x:Key="TurulSurface2">#171A1F</Color>
        <Color x:Key="TurulBorder">#24282E</Color>
        <Color x:Key="TurulGold">#E3B93F</Color>
        <Color x:Key="TurulGoldDim">#8A7322</Color>
        <Color x:Key="TurulText">#F2F0EB</Color>
        <Color x:Key="TurulTextDim">#9C9FA6</Color>
        <Color x:Key="TurulTextFaint">#5E636B</Color>
        <Color x:Key="TurulDanger">#E5484D</Color>
        <Color x:Key="TurulOk">#3DDC84</Color>
        <Color x:Key="TurulPlay">#33D17F</Color>
        <Color x:Key="TurulPlayDark">#1FA968</Color>
        <Color x:Key="TurulNavActive">#2A2310</Color>

        <SolidColorBrush x:Key="TurulBgBrush" Color="{StaticResource TurulBg}" />
        <SolidColorBrush x:Key="TurulSurfaceBrush" Color="{StaticResource TurulSurface}" />
        <SolidColorBrush x:Key="TurulSurface2Brush" Color="{StaticResource TurulSurface2}" />
        <SolidColorBrush x:Key="TurulBorderBrush" Color="{StaticResource TurulBorder}" />
        <SolidColorBrush x:Key="TurulGoldBrush" Color="{StaticResource TurulGold}" />
        <SolidColorBrush x:Key="TurulGoldDimBrush" Color="{StaticResource TurulGoldDim}" />
        <SolidColorBrush x:Key="TurulTextBrush" Color="{StaticResource TurulText}" />
        <SolidColorBrush x:Key="TurulTextDimBrush" Color="{StaticResource TurulTextDim}" />
        <SolidColorBrush x:Key="TurulTextFaintBrush" Color="{StaticResource TurulTextFaint}" />
        <SolidColorBrush x:Key="TurulDangerBrush" Color="{StaticResource TurulDanger}" />
        <SolidColorBrush x:Key="TurulOkBrush" Color="{StaticResource TurulOk}" />
        <SolidColorBrush x:Key="TurulPlayBrush" Color="{StaticResource TurulPlay}" />
        <SolidColorBrush x:Key="TurulPlayDarkBrush" Color="{StaticResource TurulPlayDark}" />
        <SolidColorBrush x:Key="TurulNavActiveBrush" Color="{StaticResource TurulNavActive}" />
        <!-- Játék-gomb: élénkzöld átmenet (mint a Windows-verzióban). -->
        <LinearGradientBrush x:Key="TurulPlayGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource TurulPlay}" />
            <GradientStop Offset="1" Color="{StaticResource TurulPlayDark}" />
        </LinearGradientBrush>
        <!-- Kijelölés-háttér: témánként változik (sárga: #241E0B). -->
        <SolidColorBrush x:Key="TurulSelectBrush" Color="#241E0B" />

        <views:IconPathToBitmapConverter x:Key="IconConverter" />
    </Application.Resources>

</Application>
