<Window
    x:Class="TurulMC.Launcher.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurulLauncher">

    <Grid x:Name="Root" Background="#07090C">
        <Grid.Resources>
            <Storyboard x:Name="StatusPulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="StatusDot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0.2" Duration="0:0:0.9"/>
            </Storyboard>
            <Storyboard x:Name="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="BarGlow"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.35" To="0.9" Duration="0:0:1.6"/>
            </Storyboard>
        </Grid.Resources>

        <Border x:Name="ShellBorder"
                Margin="1"
                CornerRadius="24"
                BorderBrush="#443613"
                BorderThickness="1"
                Padding="32,26,32,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#121820" Offset="0"/>
                    <GradientStop Color="#0A0E13" Offset="0.58"/>
                    <GradientStop Color="#06080B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Halvány óriás "T" vízjel a háttérben -->
                <TextBlock Text="T"
                           Grid.RowSpan="4"
                           FontSize="280"
                           FontWeight="Black"
                           Foreground="#FFFFFF"
                           Opacity="0.026"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,-6,-74"
                           IsHitTestVisible="False"/>

                <!-- Téma-színű fénygömb a logó mögött -->
                <Ellipse Grid.RowSpan="4"
                         Width="420" Height="420"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,-46,0,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="GlowStop" Color="#33D4AF37" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border x:Name="BrandDot" Width="8" Height="8" CornerRadius="4" Background="#D4AF37"/>
                        <TextBlock Text="TURULNETWORK"
                                   Foreground="#9AA2AD"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="180"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right"
                            Padding="10,5"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="#202731"
                            Background="#0B1015">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="v" Foreground="#5C646F" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionBadge" Text="…"
                                       Foreground="#B7BEC8"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="90"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Vékony arany elválasztó -->
                <Rectangle Grid.Row="1" Height="1" Margin="0,16,0,6" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop x:Name="DividerStop" Color="#66D4AF37" Offset="0.5"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <Grid Width="140" Height="140" Margin="0,0,0,6">
                        <!-- Lassan forgó gyűrű: vizuálisan is jelzi, hogy dolgozik a launcher -->
                        <ProgressRing x:Name="HaloRing"
                                      Width="140" Height="140"
                                      IsActive="True"
                                      Foreground="#D4AF37"
                                      Opacity="0.55"
                                      Background="Transparent"/>
                        <Ellipse x:Name="OuterHalo"
                                 Width="112" Height="112"
                                 Fill="#121720"
                                 Stroke="#443613"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <Ellipse x:Name="InnerHalo"
                                 Width="88" Height="88"
                                 Fill="#0B0F14"
                                 Stroke="#2D2615"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <Image x:Name="LogoImage"
                               Source="Assets/turul-logo.png"
                               Width="74" Height="74"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="TurulLauncher"
                               HorizontalAlignment="Center"
                               Foreground="#F4F6F9"
                               FontSize="27"
                               FontWeight="Bold"
                               CharacterSpacing="12"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="A launcher előkészítése…"
                               HorizontalAlignment="Center"
                               Foreground="#7C848F"
                               FontSize="10"
                               CharacterSpacing="35"/>

                    <!-- Fázis-jelzők: hol tart az indítás -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Border x:Name="Chip1" Padding="10,5" CornerRadius="999" Background="#0D1218" BorderThickness="1" BorderBrush="#1E252E">
                            <TextBlock x:Name="Chip1Text" Text="Beállítások" Foreground="#6B737E" FontSize="8.5" FontWeight="SemiBold" CharacterSpacing="40"/>
                        </Border>
                        <Border x:Name="Chip2" Padding="10,5" CornerRadius="999" Background="#0D1218" BorderThickness="1" BorderBrush="#1E252E">
                            <TextBlock x:Name="Chip2Text" Text="Instance-ok" Foreground="#6B737E" FontSize="8.5" FontWeight="SemiBold" CharacterSpacing="40"/>
                        </Border>
                        <Border x:Name="Chip3" Padding="10,5" CornerRadius="999" Background="#0D1218" BorderThickness="1" BorderBrush="#1E252E">
                            <TextBlock x:Name="Chip3Text" Text="Felület" Foreground="#6B737E" FontSize="8.5" FontWeight="SemiBold" CharacterSpacing="40"/>
                        </Border>
                        <Border x:Name="Chip4" Padding="10,5" CornerRadius="999" Background="#0D1218" BorderThickness="1" BorderBrush="#1E252E">
                            <TextBlock x:Name="Chip4Text" Text="Kész" Foreground="#6B737E" FontSize="8.5" FontWeight="SemiBold" CharacterSpacing="40"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="9">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="6" Height="6"
                                     Fill="#D4AF37"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText"
                                       Text="TurulLauncher indítása…"
                                       Foreground="#C3C9D2"
                                       FontSize="10.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ProgressText"
                                   Text="0%"
                                   Foreground="#D4AF37"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid>
                        <!-- Finom fény a haladássáv mögött -->
                        <Border x:Name="BarGlow"
                                Height="14"
                                CornerRadius="7"
                                Opacity="0.35"
                                Margin="0,-4,0,-4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="BarGlowStop0" Color="#00D4AF37" Offset="0"/>
                                    <GradientStop x:Name="BarGlowStop1" Color="#55D4AF37" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ProgressBar x:Name="StartupProgress"
                                     Minimum="0" Maximum="100" Value="0"
                                     Height="8"
                                     CornerRadius="4"
                                     Background="#161C23">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="BarStop0" Color="#B8961F" Offset="0"/>
                                    <GradientStop x:Name="BarStop1" Color="#D4AF37" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </Grid>

                    <TextBlock x:Name="FooterText"
                               Text="A főablak akkor jelenik meg, amikor minden készen áll."
                               Foreground="#565D68"
                               FontSize="8.5"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
