<Window
    x:Class="TurulMC.Launcher.GameLoadingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Minecraft betöltése…">

    <Grid Background="#06080B">
        <Grid.Resources>
            <Storyboard x:Name="LogoPulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="LogoGlow"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.5" To="1" Duration="0:0:1.4"/>
            </Storyboard>
        </Grid.Resources>
        <Border Margin="1" CornerRadius="20" BorderBrush="#443613" BorderThickness="1" Padding="24,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#111821" Offset="0"/>
                    <GradientStop Color="#0A0E13" Offset="0.6"/>
                    <GradientStop Color="#06080B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fejléc: logó + forgó gyűrű + állapot -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Grid Width="62" Height="62">
                            <ProgressRing x:Name="LogoRing" Width="62" Height="62" IsActive="True"
                                          Foreground="#D4AF37" Opacity="0.5" Background="Transparent"/>
                            <Ellipse x:Name="LogoGlow" Width="54" Height="54"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="GlowStop" Color="#33D4AF37" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Fill="#0B0F14" Stroke="#2D2615" StrokeThickness="1"
                                     Width="46" Height="46"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="LogoImage"
                                   Source="Assets/turul-logo.png"
                                   Width="32" Height="32"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="Minecraft betöltése…"
                                       Foreground="#F4F6F9" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="StatusText" Text="Java processz indítása…"
                                       Foreground="#C3C9D2" FontSize="11"/>
                            <TextBlock x:Name="DetailText" Text=""
                                       Foreground="#6B737E" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="10,5" CornerRadius="10"
                            Background="#0B1015" BorderThickness="1" BorderBrush="#202731">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Eltelt" Foreground="#5C646F" FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#D4AF37"
                                       FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Fázislista: mi történik éppen, és mi van kész -->
                <Border Grid.Row="1" Margin="0,16,0,0" Padding="14,12" CornerRadius="12"
                        Background="#0A0F14" BorderThickness="1" BorderBrush="#1B222B">
                    <StackPanel Spacing="9">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="Stage1Dot" Width="8" Height="8" Fill="#D4AF37" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Stage1Text" Text="Java előkészítése" Foreground="#E7EBF0" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="Stage2Dot" Width="8" Height="8" Fill="#2A323C" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Stage2Text" Text="Minecraft fájlok és Fabric ellenőrzése" Foreground="#8C95A1" FontSize="10.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="Stage3Dot" Width="8" Height="8" Fill="#2A323C" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Stage3Text" Text="Játék indítása (modok betöltése)" Foreground="#8C95A1" FontSize="10.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="Stage4Dot" Width="8" Height="8" Fill="#2A323C" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Stage4Text" Text="Játékablak megjelenése" Foreground="#8C95A1" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Napló + tipp -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,7">
                        <TextBlock Text="NAPLÓ" Foreground="#5C646F" FontSize="8.5"
                                   FontWeight="SemiBold" CharacterSpacing="140"/>
                        <TextBlock x:Name="LogCountText" Text="0 sor" Foreground="#4A515B" FontSize="8.5"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Grid.Row="1" CornerRadius="10" Background="#080C10"
                            BorderThickness="1" BorderBrush="#1A212A" Padding="10,8">
                        <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogBox"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Foreground="#9AA1AB"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"/>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,9" CornerRadius="10"
                            Background="#0C1116" BorderThickness="1" BorderBrush="#1B222B">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="TIPP" Foreground="#D4AF37" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" CharacterSpacing="120"/>
                            <TextBlock x:Name="TipText" Text="" Foreground="#8C95A1" FontSize="9.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock x:Name="FooterHintText"
                               Text="A sok mod lassíthatja a betöltést — ez normális."
                               Foreground="#565D68" FontSize="9" VerticalAlignment="Center"/>
                    <Button x:Name="HideButton" Content="Elrejtés (a játék fut tovább)" Click="OnHideClick"
                            HorizontalAlignment="Right"
                            Background="#D4AF37" Foreground="#08090B" BorderThickness="0"
                            FontWeight="SemiBold" Padding="16,8" CornerRadius="9"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
